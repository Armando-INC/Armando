# Copia este archivo como .env (cp .env.example .env) y llena los valores.
# .env NO se sube a git: aquí van tu número y las claves de Twilio.

# ---------- Modo prueba ----------
# true  -> TODAS las llamadas van a NUMERO_PRUEBA (tu celular). Nunca se llama a la policía.
# false -> se llama al teléfono real del cuadrante/CAI más cercano. Solo con autorización.
MODO_PRUEBA=true
# Tu celular, con indicativo: +573001234567 (también acepta 3001234567)
NUMERO_PRUEBA=

# ---------- Twilio (https://console.twilio.com) ----------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Número que compraste/obtuviste en Twilio y desde el que se llama, ej. +12025550123
TWILIO_NUMERO_ORIGEN=
# Voz del mensaje (Amazon Polly vía Twilio). Polly.Mia = español de México.
TWILIO_VOZ=Polly.Mia
# Cuántas veces se repite el mensaje en la llamada
REPETICIONES_MENSAJE=2

# ---------- Ubicación de la cámara ----------
# El nombre es lo que dice la llamada: "Se reportó un arma de fuego en la ubicación: <nombre>, <dirección>"
UBICACION_NOMBRE=
UBICACION_DIRECCION=
# Coordenadas exactas (recomendado). Si las pones, no se geocodifica la dirección.
UBICACION_LAT=
UBICACION_LON=
# Se agrega a la dirección al geocodificar si no la trae
CIUDAD=Bogotá

# ---------- Geocodificación (dirección -> coordenadas) ----------
# Opcional. Con clave de Google las direcciones colombianas ("Calle 60 # 7-20") salen bien.
# Sin clave se usa OpenStreetMap (Nominatim), que es APROXIMADO para direcciones colombianas.
GOOGLE_MAPS_API_KEY=

# ---------- Policía más cercana ----------
# Si no hay cuadrante con teléfono que cubra el punto, se busca la policía con teléfono más cercana hasta esta distancia
DISTANCIA_MAX_KM=20

# ---------- Mapa y servidor local ----------
URL_MAPA=https://armando-inc.github.io/Armando/Armando/directorio/mapa_directorio.html
PUERTO=8000

# ---------- Detector ----------
# Índice de la webcam (0, 1...) o URL RTSP/HTTP de la cámara
CAMARA=0
# rgb o gray
MODELO=rgb
UMBRAL_CONFIANZA=0.6
# Se dispara la alerta cuando hay arma en FRAMES_CONFIRMACION de los últimos VENTANA_FRAMES
FRAMES_CONFIRMACION=5
VENTANA_FRAMES=10
# Segundos mínimos entre dos alertas de la misma cámara
ENFRIAMIENTO_S=120
