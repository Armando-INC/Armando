# ── Secretos ──────────────────────────────────────────────────────────
# .env tiene tu número y las claves de Twilio: nunca se sube.
# Solo se versiona .env.example (la plantilla sin valores).
.env
.env.*
!.env.example

# ── Datos que genera Armando al ejecutarse ────────────────────────────
# alertas, fotos de las detecciones (salen personas) y caché de direcciones
sistema/registro/

# ── Python ────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ipynb_checkpoints/
*.egg-info/
build/
dist/

# ── Entrenamiento de modelos (Ultralytics) ────────────────────────────
# corridas y datasets pesan mucho: los pesos finales van en modelos/
runs/
datasets/
*.cache

# ── Documento académico (LaTeX): solo fuentes, imágenes y PDF ─────────
docs/documento-academico/*
!docs/documento-academico/Images/
!docs/documento-academico/*.tex
!docs/documento-academico/*.bib
!docs/documento-academico/*.pdf

# ── Editores, sistema operativo y herramientas locales ────────────────
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db
*.log
.claude/
